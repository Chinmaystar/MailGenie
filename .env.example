# ---- Server ----
PORT=3001
SEND_DELAY_MS=5000

# ---- LLM (OpenAI or any OpenAI-compatible endpoint) ----
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# ---- RAG ----
# bm25 = free, local, keyword-based (default).
# embeddings = OpenAI embeddings for semantic search (uses LLM_API_KEY).
RAG_PROVIDER=bm25
EMBEDDING_MODEL=text-embedding-3-small

# ---- Email (Resend) ----
RESEND_API_KEY=
FROM_EMAIL=
FROM_NAME=Kelvor